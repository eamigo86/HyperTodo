# Cleartext + localhost is an explicit opt-in, never a default: app.config.ts
# refuses to resolve without it, so no build path can silently bake a local URL
# into a store binary. Copy this file to mobile/.env (gitignored) for development.
EXPO_PUBLIC_ALLOW_LOCAL_API=1

# iOS Simulator (this is also the default the opt-in unlocks)
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/hv/
# Android Emulator alternative:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/hv/
