DJANGO_SECRET_KEY=replace-for-local-development
DJANGO_DEBUG=1
TIME_ZONE=America/New_York
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://10.0.2.2:8000
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,10.0.2.2
ENABLE_REDIS_CACHE=1
REDIS_URL=redis://127.0.0.1:6379/15
# Optional DEBUG overrides. Defaults: admin123 and demo123.
HYPERTODO_ADMIN_PASSWORD=choose-a-local-admin-password
HYPERTODO_DEMO_PASSWORD=choose-a-local-demo-password
