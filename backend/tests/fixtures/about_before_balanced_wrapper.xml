{% load i18n %}<?xml version="1.0" encoding="UTF-8"?>
<doc xmlns="https://hyperview.org/hyperview">
  <screen id="about-screen">
  <styles>
    <style id="screen" backgroundColor="{{ theme.canvas }}" flex="1" />
    <style id="screen-header-style" alignItems="center" backgroundColor="{{ theme.brand }}" flexDirection="row" height="44" paddingHorizontal="8" />
    <style id="back-button" alignItems="center" flexDirection="row" height="44" width="84" />
    <style id="back-chevron" color="{{ theme.on_brand }}" fontSize="34" lineHeight="36" marginRight="2" />
    <style id="back-label" color="{{ theme.on_brand }}" fontSize="19" fontWeight="700" />
    <style id="screen-header-title-slot" alignItems="center" flex="1" justifyContent="center" />
    <style id="screen-header-spacer" width="84" />
    <style id="screen-header-title" color="{{ theme.on_brand }}" fontSize="19" fontWeight="700" />
    <style id="content" flex="1" />
    <style id="content-inner" padding="24" paddingBottom="40" />
    <style id="hero" alignItems="center" backgroundColor="{{ theme.surface }}" borderRadius="24" padding="24" />
    <style id="app-name" color="{{ theme.ink }}" fontSize="28" fontWeight="800" />
    <style id="app-version-style" color="{{ theme.link_ink }}" fontSize="15" fontWeight="700" marginTop="6" />
    <style id="description" color="{{ theme.ink_muted }}" fontSize="16" lineHeight="23" marginTop="16" textAlign="center" />
    <style id="section-title" color="{{ theme.ink }}" fontSize="22" fontWeight="800" marginBottom="12" marginTop="28" />
    <style id="technology-card" backgroundColor="{{ theme.surface }}" borderRadius="18" marginBottom="10" padding="16" />
    <style id="technology-name" color="{{ theme.ink }}" fontSize="17" fontWeight="700" />
    <style id="technology-copy" color="{{ theme.ink_muted }}" fontSize="14" lineHeight="20" marginTop="3" />
    <style id="package-version" color="{{ theme.ink_muted }}" fontSize="13" marginTop="22" textAlign="center" />
    <style id="copyright" color="{{ theme.ink_muted }}" fontSize="12" marginTop="8" textAlign="center" />
  </styles>
    <body style="screen">
      {% if realtime_enabled %}<app:realtime xmlns:app="https://hypertodo.app/components" resources="{{ realtime_resources }}" refresh-href="{{ realtime_refresh_href }}" target="{{ realtime_target }}" mode="{{ realtime_mode }}"><app:realtime-page xmlns:app="https://hypertodo.app/components" request-id="{{ realtime_request_id }}" page="1" />{% endif %}
      {% include "partials/screen_header.xml" with header_title=_("About") back_id="about-back" %}
      <view style="content" scroll="true" shows-scroll-indicator="false" content-container-style="content-inner">
        <view style="hero">
          <text style="app-name">HyperTodo</text>
          <text id="about-app-version" style="app-version-style">HyperTodo {{ app_version }}</text>
          <text style="description">{% translate "A calm, server-driven place to organize tasks, categories, and the work that matters." %}</text>
        </view>
        <text style="section-title">{% translate "Built with" %}</text>
        <view style="technology-card"><text style="technology-name">Django</text><text style="technology-copy">{% blocktranslate %}Backend, authentication, data, and business rules. Version {{ django_version }}.{% endblocktranslate %}</text></view>
        <view style="technology-card"><text style="technology-name">dj-hyperview</text><text style="technology-copy">{% translate "Template sources, validation, caching, and server-driven responses." %}</text></view>
        <view style="technology-card"><text style="technology-name">Hyperview</text><text style="technology-copy">{% blocktranslate %}Native mobile interface rendered from HXML. Version {{ hyperview_version }}.{% endblocktranslate %}</text></view>
        <view style="technology-card"><text style="technology-name">Expo</text><text style="technology-copy">{% translate "React Native host, device services, and development workflow." %}</text></view>
        <text id="about-package-version" style="package-version">dj-hyperview {{ dj_hyperview_version }}</text>
        <text id="about-copyright" style="copyright">© {{ copyright_year }} HyperTodo. {% translate "All rights reserved." %}</text>
      </view>
    {% if realtime_enabled %}</app:realtime>{% endif %}
    </body>
  </screen>
</doc>
