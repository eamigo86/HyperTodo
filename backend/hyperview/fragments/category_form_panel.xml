{% load dj_hyperview i18n %}<view xmlns="https://hyperview.org/hyperview" id="category-form-panel">
  {% if form.errors %}<behavior trigger="load" action="show-snackbar" message="{% translate "Please review the highlighted category details." %}" tone="error" once="true" />{% endif %}
  <form id="category-form">
    <!-- No id on an error <text>. HvText builds its props with createProps
         (elements/hv-text/index.tsx:15) and createProps spreads createTestProps
         LAST (services/index.ts:161), so on every non-iOS platform the id lands
         as accessibilityLabel (:81-84) and TalkBack reads the SLUG instead of the
         sentence saying why the save was refused. Tests select these by style. -->
    {% if form.errors %}<view style="error-card"><text style="error-text">{% translate "Review the fields marked in red." %}</text></view>{% endif %}
    <view style="card">
      <text style="section">{% translate "Details" %}</text>
      {% if form.non_field_errors %}<text style="field-error">{{ form.non_field_errors|join:', ' }}</text>{% endif %}
      <text style="label">{% translate "Name" %}</text>
      <text-field name="name" value="{{ form.name.value|default:'' }}" placeholder="{% translate "Category name" %}" placeholderTextColor="{{ theme.ink_muted }}" accessibilityLabel="{% translate "Category name" %}" style="field{% if form.name.errors %} field-invalid{% endif %}" />
      {% if form.name.errors %}<text style="field-error">{{ form.name.errors|join:', ' }}</text>{% endif %}
      <text style="label">{% translate "Color" %}</text>
      <select-single name="color" style="color-select">
        {% for value,label in form.fields.color.choices %}
        <option style="color-option" value="{{ value }}"{% if form.color.value == value %} selected="true"{% endif %}>
          <view style="color-swatch {{ value }}" />
          <text style="color-option-text">{{ label }}</text>
        </option>
        {% endfor %}
      </select-single>
      {% if form.color.errors %}<text style="field-error">{{ form.color.errors|join:', ' }}</text>{% endif %}
    </view>
    {% hv_csrf_token %}
    <view id="category-submit" style="button" href="{% if category %}/hv/categories/{{ category.id }}/edit/{% else %}/hv/categories/new/{% endif %}" verb="post" action="replace" target="category-form-panel"><text style="button-text">{% translate "Save category" %}</text></view>
  </form>
</view>
