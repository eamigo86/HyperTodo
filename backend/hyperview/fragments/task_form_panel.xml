{% load dj_hyperview i18n %}<view xmlns="https://hyperview.org/hyperview" id="task-form-panel">
  {% if form.errors %}<behavior trigger="load" action="show-snackbar" message="{% translate "Please review the highlighted task details." %}" tone="error" once="true" />{% endif %}
  <form id="task-form">
    <!-- No id on an error <text>. HvText builds its props with createProps
         (elements/hv-text/index.tsx:15) and createProps spreads createTestProps
         LAST (services/index.ts:161), so on every non-iOS platform the id lands
         as accessibilityLabel (:81-84) and TalkBack reads the SLUG instead of the
         sentence saying why the save was refused. Tests select these by style. -->
    {% if form.errors %}<view style="error-card"><text style="error-text">{% translate "Review the fields marked in red." %}</text></view>{% endif %}
    <view style="card">
      <text style="section">{% translate "Details" %}</text>
      {% if form.non_field_errors %}<text style="field-error">{{ form.non_field_errors|join:', ' }}</text>{% endif %}
      <text style="label">{% translate "Title" %}</text>
      <text-field name="title" value="{{ form.title.value|default:'' }}" placeholder="{% translate "What needs doing?" %}" placeholderTextColor="{{ theme.ink_muted }}" accessibilityLabel="{% translate "Title" %}" style="field{% if form.title.errors %} field-invalid{% endif %}" />
      {% if form.title.errors %}<text style="field-error">{{ form.title.errors|join:', ' }}</text>{% endif %}
      <text style="label">{% translate "Notes" %}</text>
      <text-field name="notes" value="{{ form.notes.value|default:'' }}" placeholder="{% translate "Optional details" %}" placeholderTextColor="{{ theme.ink_muted }}" multiline="true" accessibilityLabel="{% translate "Notes" %}" style="field field-multiline{% if form.notes.errors %} field-invalid{% endif %}" />
      {% if form.notes.errors %}<text style="field-error">{{ form.notes.errors|join:', ' }}</text>{% endif %}
      <text style="label">{% translate "Category" %}</text>
      <picker-field id="task-category" name="category" value="{{ form.category.value|default:'' }}" field-style="picker-box{% if form.category.errors %} field-invalid{% endif %}" field-text-style="field-text" modal-style="date-modal" modal-overlay-style="date-modal-overlay" modal-text-style="date-modal-action" cancel-label="{% translate "Cancel" %}" done-label="{% translate "Done" %}" placeholder="{% translate "No category" %}" placeholderTextColor="{{ theme.ink_muted }}">
        <picker-item label="{% translate "No category" %}" value="" />
        {% for option in form.fields.category.queryset %}<picker-item label="{{ option.name }}" value="{{ option.id }}" />{% endfor %}
      </picker-field>
      {% if form.category.errors %}<text style="field-error">{{ form.category.errors|join:', ' }}</text>{% endif %}
    </view>
    <view style="card">
      <text style="section">{% translate "Schedule" %}</text>
      <text style="label">{% translate "Due date" %}</text>
      <date-field name="due_date" value="{{ form.due_date.value|date:'Y-m-d'|default:'' }}" field-style="field{% if form.due_date.errors %} field-invalid{% endif %}" field-text-style="field-text" label-format="DD/MM/YYYY" modal-style="date-modal" modal-overlay-style="date-modal-overlay" modal-text-style="date-modal-action" cancel-label="{% translate "Cancel" %}" done-label="{% translate "Done" %}" placeholder="{% translate "Select due date" %}" placeholderTextColor="{{ theme.ink_muted }}" />
      {% if form.due_date.errors %}<text style="field-error">{{ form.due_date.errors|join:', ' }}</text>{% endif %}
      <text style="label">{% translate "Due time" %}</text>
      <text-field name="due_time" value="{{ form.due_time.value|time:'H:i'|default:'' }}" placeholder="HH:MM" placeholderTextColor="{{ theme.ink_muted }}" keyboard-type="number-pad" mask="99:99" accessibilityLabel="{% translate "Due time" %}" style="field{% if form.due_time.errors %} field-invalid{% endif %}" />
      {% if form.due_time.errors %}<text style="field-error">{{ form.due_time.errors|join:', ' }}</text>{% endif %}
    </view>
    {% hv_csrf_token %}
    <view id="task-submit" style="button" href="{% if task %}/hv/tasks/{{ task.id }}/edit/{% else %}/hv/tasks/new/{% endif %}" verb="post" action="replace" target="task-form-panel"><text style="button-text">{% translate "Save task" %}</text></view>
  </form>
</view>
