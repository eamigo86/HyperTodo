{% load dj_hyperview %}<view xmlns="https://hyperview.org/hyperview" id="task-form-panel">
  <view style="header">
    <view id="task-back" style="back-button" action="back"><text style="back">&lt;</text></view>
    <text style="title">{% if task %}Edit task{% else %}New task{% endif %}</text>
  </view>
  <form id="task-form">
    <view style="card">
      {% if form.errors %}<text id="form-errors" style="error">Please correct the highlighted task details.</text>{% endif %}
      <text style="label">Title</text>
      <text-field name="title" value="{{ form.title.value|default:'' }}" placeholder="What needs doing?" style="field" />
      <text style="label">Notes</text>
      <text-field name="notes" value="{{ form.notes.value|default:'' }}" placeholder="Optional details" multiline="true" style="field" />
      <text style="label">Category</text>
      <select-single name="category" style="select">
        <option style="option" value=""{% if not form.category.value %} selected="true"{% endif %}><text style="option-text">No category</text></option>
        {% for option in form.fields.category.queryset %}<option style="option" value="{{ option.id }}"{% if form.category.value|stringformat:'s' == option.id|stringformat:'s' %} selected="true"{% endif %}><text style="option-text">{{ option.name }}</text></option>{% endfor %}
      </select-single>
      <text style="label">Due date</text>
      <date-field name="due_date" value="{{ form.due_date.value|date:'Y-m-d'|default:'' }}" field-style="field" field-text-style="field-text" label-format="MMM D, YYYY" placeholder="Select due date" />
      <text style="label">Due time</text>
      <text-field name="due_time" value="{{ form.due_time.value|time:'H:i'|default:'' }}" placeholder="HH:MM" keyboard-type="number-pad" mask="99:99" style="field" />
      {% hv_csrf_token %}
      <view id="task-submit" style="button" href="{% if task %}/hv/tasks/{{ task.id }}/edit/{% else %}/hv/tasks/new/{% endif %}" verb="post" action="replace" target="task-form-panel"><text style="button-text">Save task</text></view>
    </view>
  </form>
</view>
