<view xmlns="https://hyperview.org/hyperview" id="bottom-navigation" style="bottom-navigation">
  <view id="nav-dashboard" style="nav-item{% if active_nav == 'dashboard' %} nav-active{% endif %}" href="/hv/dashboard/" action="navigate">
    <text style="nav-symbol">⌂</text>
    <text style="nav-label">Home</text>
  </view>
  <view id="nav-tasks" style="nav-item{% if active_nav == 'tasks' %} nav-active{% endif %}" href="/hv/tasks/" action="navigate">
    <text style="nav-symbol">✓</text>
    <text style="nav-label">Tasks</text>
  </view>
  <view id="nav-add-task" style="nav-add" href="/hv/tasks/new/" action="new">
    <text style="nav-add-symbol">+</text>
  </view>
  <view id="nav-categories" style="nav-item{% if active_nav == 'categories' %} nav-active{% endif %}" href="/hv/categories/" action="navigate">
    <text style="nav-symbol">◇</text>
    <text style="nav-label">Categories</text>
  </view>
  <view id="open-side-menu" style="nav-item" action="show" target="side-menu">
    <text style="nav-symbol">≡</text>
    <text style="nav-label">Menu</text>
  </view>
</view>
