{% load i18n static %}<view xmlns="https://hyperview.org/hyperview" id="bottom-navigation" style="bottom-navigation">
  <view id="nav-dashboard" href-style="nav-hit-area" style="nav-item{% if active_nav == 'dashboard' %} nav-active{% endif %}" href="#root-route" action="navigate">
    <image style="nav-icon{% if active_nav == 'dashboard' %} nav-icon-active{% endif %}" source="{% static 'todo/icons/home.png' %}" />
    <text style="nav-label{% if active_nav == 'dashboard' %} nav-label-active{% endif %}">{% translate "Home" %}</text>
  </view>
  <view id="nav-tasks" href-style="nav-hit-area" style="nav-item{% if active_nav == 'tasks' %} nav-active{% endif %}" href="/hv/tasks/" action="navigate">
    <image style="nav-icon{% if active_nav == 'tasks' %} nav-icon-active{% endif %}" source="{% static 'todo/icons/tasks.png' %}" />
    <text style="nav-label{% if active_nav == 'tasks' %} nav-label-active{% endif %}">{% translate "Tasks" %}</text>
  </view>
  <view id="nav-add-task" href-style="nav-hit-area" style="nav-add" href="/hv/tasks/new/" action="navigate">
    <text style="nav-add-symbol">+</text>
  </view>
  <view id="nav-categories" href-style="nav-hit-area" style="nav-item{% if active_nav == 'categories' %} nav-active{% endif %}" href="/hv/categories/" action="navigate">
    <image style="nav-icon{% if active_nav == 'categories' %} nav-icon-active{% endif %}" source="{% static 'todo/icons/categories.png' %}" />
    <text style="nav-label{% if active_nav == 'categories' %} nav-label-active{% endif %}">{% translate "Categories" %}</text>
  </view>
  <view id="nav-settings" href-style="nav-hit-area" style="nav-item{% if active_nav == 'settings' %} nav-active{% endif %}" href="/hv/settings/" action="navigate">
    <image style="nav-icon{% if active_nav == 'settings' %} nav-icon-active{% endif %}" source="{% static 'todo/icons/settings.png' %}" />
    <text style="nav-label{% if active_nav == 'settings' %} nav-label-active{% endif %}">{% translate "Settings" %}</text>
  </view>
</view>
