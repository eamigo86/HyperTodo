{% load static %}<view xmlns="https://hyperview.org/hyperview" id="bottom-navigation" style="bottom-navigation">
  <view id="nav-dashboard" href-style="nav-hit-area" style="nav-item{% if active_nav == 'dashboard' %} nav-active{% endif %}" href="/hv/dashboard/" action="navigate">
    {% if active_nav == 'dashboard' %}<image style="nav-icon" source="{% static 'todo/icons/home-active.png' %}" />{% else %}<image style="nav-icon" source="{% static 'todo/icons/home.png' %}" />{% endif %}
    <text style="nav-label{% if active_nav == 'dashboard' %} nav-label-active{% endif %}">Home</text>
  </view>
  <view id="nav-tasks" href-style="nav-hit-area" style="nav-item{% if active_nav == 'tasks' %} nav-active{% endif %}" href="/hv/tasks/" action="navigate">
    {% if active_nav == 'tasks' %}<image style="nav-icon" source="{% static 'todo/icons/tasks-active.png' %}" />{% else %}<image style="nav-icon" source="{% static 'todo/icons/tasks.png' %}" />{% endif %}
    <text style="nav-label{% if active_nav == 'tasks' %} nav-label-active{% endif %}">Tasks</text>
  </view>
  <view id="nav-add-task" href-style="nav-hit-area" style="nav-add" href="/hv/tasks/new/" action="new">
    <text style="nav-add-symbol">+</text>
  </view>
  <view id="nav-categories" href-style="nav-hit-area" style="nav-item{% if active_nav == 'categories' %} nav-active{% endif %}" href="/hv/categories/" action="navigate">
    {% if active_nav == 'categories' %}<image style="nav-icon" source="{% static 'todo/icons/categories-active.png' %}" />{% else %}<image style="nav-icon" source="{% static 'todo/icons/categories.png' %}" />{% endif %}
    <text style="nav-label{% if active_nav == 'categories' %} nav-label-active{% endif %}">Categories</text>
  </view>
  <view id="open-side-menu" href-style="nav-hit-area" style="nav-item">
    <image style="nav-icon" source="{% static 'todo/icons/menu.png' %}" />
    <text style="nav-label">Menu</text>
    <behavior trigger="press" action="show" target="side-menu" />
  </view>
</view>
