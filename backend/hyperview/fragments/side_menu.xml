{% load dj_hyperview i18n static %}<side-menu xmlns="https://hypertodo.app/components" id="side-menu-host" style="side-menu" close-href="/hv/menu/close/" animation-duration="220" panel-width="80">
  <view xmlns="https://hyperview.org/hyperview" style="side-menu-panel">
    <!-- The header bleeds edge to edge under the client's close chip, which is
         hardcoded at top:20 right:20 (AnimatedSideMenu.tsx:120-130). The
         paddingRight on side-menu-header is what keeps these two lines out from
         under it, and numberOfLines is the belt for a long name. -->
    <view style="side-menu-header">
      {% if request.user.profile.avatar %}<image style="side-menu-avatar" source="{{ request.user.profile.avatar.url }}" alt="{% translate "Your profile photo" %}" />{% else %}<view style="side-menu-avatar"><text style="side-menu-initials">{{ initials }}</text></view>{% endif %}
      <view style="side-menu-identity">
        <text style="side-menu-name" numberOfLines="1" ellipsizeMode="tail">{{ request.user.get_full_name|default:request.user.get_username }}</text>
        <text style="side-menu-email" numberOfLines="1" ellipsizeMode="tail">{% if request.user.email %}{{ request.user.email }}{% else %}@{{ request.user.get_username }}{% endif %}</text>
      </view>
    </view>
    <view style="side-menu-links">
      <!-- EVERY link needs the close, not just Home. Two press behaviors run in
           document order because getBehaviorElements unshifts the element itself
           (services/dom/helpers.ts:8-18), and the queued replace still lands on the
           dashboard route's own onUpdate after the navigate. Home would otherwise
           look dead: NAVIGATE to the focused route returns that same route
           (StackRouter.js:242-244), so nothing covers the overlay. The other three
           are worse: they push a card over a dashboard that keeps the open menu in
           its document, and the pop back never refetches (hv-doc.tsx:178-193), so
           the scrim and the panel return covering the whole bottom navigation.
           The glyphs carry no alt and no id, so they are decorative on both
           platforms and the row's own text is the single announcement. That text
           is also the only node that can carry the role: HvView copies no
           attributes and HyperRef's TouchableOpacity is accessible={false}, so
           without accessibilityRole here every row reads as static text. -->
      <view style="side-menu-link{% if active_nav == 'dashboard' %} side-menu-link-active{% endif %}" href="#root-route" action="navigate">
        <behavior trigger="press" href="/hv/menu/close/" action="replace" target="side-menu-host" />
        <image style="side-menu-icon{% if active_nav == 'dashboard' %} side-menu-icon-active{% endif %}" source="{% static 'todo/icons/home.png' %}" />
        <text style="side-menu-link-text" accessibilityRole="button">{% translate "Home" %}</text>
      </view>
      <view style="side-menu-link{% if active_nav == 'tasks' %} side-menu-link-active{% endif %}" href="/hv/tasks/" action="navigate">
        <behavior trigger="press" href="/hv/menu/close/" action="replace" target="side-menu-host" />
        <image style="side-menu-icon{% if active_nav == 'tasks' %} side-menu-icon-active{% endif %}" source="{% static 'todo/icons/tasks.png' %}" />
        <text style="side-menu-link-text" accessibilityRole="button">{% translate "Tasks" %}</text>
      </view>
      <view style="side-menu-link{% if active_nav == 'categories' %} side-menu-link-active{% endif %}" href="/hv/categories/" action="navigate">
        <behavior trigger="press" href="/hv/menu/close/" action="replace" target="side-menu-host" />
        <image style="side-menu-icon{% if active_nav == 'categories' %} side-menu-icon-active{% endif %}" source="{% static 'todo/icons/categories.png' %}" />
        <text style="side-menu-link-text" accessibilityRole="button">{% translate "Categories" %}</text>
      </view>
      <view style="side-menu-link{% if active_nav == 'settings' %} side-menu-link-active{% endif %}" href="/hv/settings/" action="navigate">
        <behavior trigger="press" href="/hv/menu/close/" action="replace" target="side-menu-host" />
        <image style="side-menu-icon{% if active_nav == 'settings' %} side-menu-icon-active{% endif %}" source="{% static 'todo/icons/settings.png' %}" />
        <text style="side-menu-link-text" accessibilityRole="button">{% translate "Settings" %}</text>
      </view>
      <view style="side-menu-link{% if active_nav == 'about' %} side-menu-link-active{% endif %}" href="/hv/about/" action="navigate">
        <behavior trigger="press" href="/hv/menu/close/" action="replace" target="side-menu-host" />
        <image style="side-menu-icon{% if active_nav == 'about' %} side-menu-icon-active{% endif %}" source="{% static 'todo/icons/alert.png' %}" />
        <text style="side-menu-link-text" accessibilityRole="button">{% translate "About" %}</text>
      </view>
    </view>
    <!-- The drawer supplies the form the switcher no longer carries, the same
         shape it already wraps sign-out in. It holds nothing but the CSRF token,
         because there is nothing else here to post; on Settings the same partial
         sits inside the profile form instead, and that is the whole of the
         difference between the two hosts.
         side-menu-preferences and NOT side-menu-links: the links block is flex="1"
         and a second flex="1" sibling would take half the panel for itself. -->
    <view style="side-menu-preferences">
      <form id="side-menu-preference-form">
        {% hv_csrf_token %}
        {% include "partials/preference_switcher.xml" %}
      </form>
    </view>
    <!-- The chrome sits on the OUTER wrapper. logout-panel is the replace target and
         fragments/logout_transition.xml answers with a bare unstyled <view
         id="logout-panel">, so anything styled here would vanish for the instant
         between the POST and the reload. -->
    <view style="side-menu-footer">
      <view id="logout-panel">
        <form id="side-menu-logout-form">
          {% hv_csrf_token %}
          <view id="side-menu-logout" style="side-menu-logout-style" href="/hv/logout/" verb="post" action="replace" target="logout-panel">
            <image style="side-menu-logout-icon" source="{% static 'todo/icons/logout.png' %}" />
            <text style="side-menu-logout-text" accessibilityRole="button">{% translate "Sign out" %}</text>
          </view>
        </form>
      </view>
    </view>
  </view>
</side-menu>
