<view xmlns="https://hyperview.org/hyperview" id="category-transition">{% if realtime_enabled and realtime_fragment == "fragments/category_transition.xml" %}<app:realtime-page xmlns:app="https://hypertodo.app/components" request-id="{{ realtime_request_id }}" page="1" />{% endif %}
  <behavior trigger="load" action="show-snackbar" message="{{ notice_message }}" tone="success" once="true" />
  <!-- See task_transition.xml for the reasoning: `back` pops the screen this
       fragment just emptied, and carries no delay because the blank panel is
       already committed by the time a timer would fire. -->
  {% if realtime_enabled %}<behavior trigger="load" action="notify-resources" resources="categories" once="true" />{% else %}<behavior trigger="load" action="dispatch-event" event-name="categories-changed" once="true" />{% endif %}
  <behavior trigger="load" action="back" />
</view>
