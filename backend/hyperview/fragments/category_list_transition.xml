<view xmlns="https://hyperview.org/hyperview" id="category-list-transition">{% if realtime_enabled and realtime_fragment == "fragments/category_list_transition.xml" %}<app:realtime-page xmlns:app="https://hypertodo.app/components" request-id="{{ realtime_request_id }}" page="1" />{% endif %}
  <behavior trigger="load" action="show-snackbar" message="{{ notice_message }}" tone="success" once="true" />
  <!-- Mirrors task_list_transition.xml: one announcement covers form-save and
       delete, and the categories screen's listener replaces just the list instead
       of re-fetching the whole screen document. -->
  {% if realtime_enabled %}<behavior trigger="load" action="notify-resources" resources="categories" once="true" />{% else %}<behavior trigger="load" action="dispatch-event" event-name="categories-changed" once="true" />{% endif %}
</view>
