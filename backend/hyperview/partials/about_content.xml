{% load i18n %}
      {% include "partials/screen_header.xml" with header_title=_("About") back_id="about-back" %}
      <view style="content" scroll="true" shows-scroll-indicator="false" content-container-style="content-inner">
        <view style="hero">
          <text style="app-name">HyperTodo</text>
          <text id="about-app-version" style="app-version-style">HyperTodo {{ app_version }}</text>
          <text style="description">{% translate "A calm, server-driven place to organize tasks, categories, and the work that matters." %}</text>
        </view>
        <text style="section-title">{% translate "Built with" %}</text>
        <view style="technology-card"><text style="technology-name">Django</text><text style="technology-copy">{% blocktranslate %}Backend, authentication, data, and business rules. Version {{ django_version }}.{% endblocktranslate %}</text></view>
        <view style="technology-card"><text style="technology-name">dj-hyperview</text><text style="technology-copy">{% translate "Template sources, validation, caching, and server-driven responses." %}</text></view>
        <view style="technology-card"><text style="technology-name">Hyperview</text><text style="technology-copy">{% blocktranslate %}Native mobile interface rendered from HXML. Version {{ hyperview_version }}.{% endblocktranslate %}</text></view>
        <view style="technology-card"><text style="technology-name">Expo</text><text style="technology-copy">{% translate "React Native host, device services, and development workflow." %}</text></view>
        <text id="about-package-version" style="package-version">dj-hyperview {{ dj_hyperview_version }}</text>
        <text id="about-copyright" style="copyright">© {{ copyright_year }} HyperTodo. {% translate "All rights reserved." %}</text>
      </view>
