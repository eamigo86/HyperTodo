{% load dj_hyperview %}<?xml version="1.0" encoding="UTF-8"?>
<doc xmlns="https://hyperview.org/hyperview">
  <styles>
    <style id="screen" backgroundColor="#F7F8FC" padding="24" /><style id="title" color="#161A35" fontSize="27" fontWeight="700" marginBottom="20" /><style id="card" backgroundColor="#FFFFFF" borderRadius="28" padding="20" /><style id="label" color="#4C526B" fontSize="13" fontWeight="600" marginTop="12" marginBottom="6" /><style id="field" backgroundColor="#F1F4FC" borderRadius="16" padding="13" /><style id="button" backgroundColor="#278CFF" borderRadius="18" padding="16" marginTop="22" /><style id="button-text" color="#FFFFFF" fontWeight="700" textAlign="center" /><style id="error" color="#B42318" marginBottom="10" />
  </styles>
  <screen id="category-form-screen"><body style="screen"><text style="title">{% if category %}Edit category{% else %}New category{% endif %}</text><form id="category-form"><view style="card">{% if form.errors %}<text id="form-errors" style="error">Please correct the category details.</text>{% endif %}<text style="label">Name</text><text-field name="name" value="{{ form.name.value|default:'' }}" placeholder="Category name" style="field" /><text style="label">Color</text><select-single name="color" style="field">{% for value,label in form.fields.color.choices %}<option value="{{ value }}"{% if form.color.value == value %} selected="true"{% endif %}>{{ label }}</option>{% endfor %}</select-single>{% hv_csrf_token %}<view style="button" href="{% if category %}/hv/categories/{{ category.id }}/edit/{% else %}/hv/categories/new/{% endif %}" verb="post" action="replace"><text style="button-text">Save category</text></view></view></form></body></screen>
</doc>
