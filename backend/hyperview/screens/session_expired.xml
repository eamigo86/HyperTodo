{% load i18n %}<?xml version="1.0" encoding="UTF-8"?>
<doc xmlns="https://hyperview.org/hyperview">
  <screen id="session-expired-screen">
  <styles>
    <style id="screen" backgroundColor="{{ theme.brand }}" padding="28" justifyContent="center" />
    <style id="card" backgroundColor="{{ theme.surface }}" borderRadius="28" padding="24" />
    <style id="title" color="{{ theme.ink }}" fontSize="24" fontWeight="700" />
    <style id="copy" color="{{ theme.ink_muted_alt }}" fontSize="16" marginTop="8" />
    <style id="button" backgroundColor="{{ theme.brand }}" borderRadius="18" padding="16" marginTop="24">
      <modifier pressed="true"><style backgroundColor="{{ theme.brand_pressed }}" /></modifier>
    </style>
    <style id="button-text" color="{{ theme.on_brand }}" fontSize="19" fontWeight="700" textAlign="center">
      <modifier pressed="true"><style color="{{ theme.on_brand }}" /></modifier>
    </style>
  </styles>
    <body style="screen">
      {% if realtime_enabled %}<app:realtime xmlns:app="https://hypertodo.app/components" resources="{{ realtime_resources }}" refresh-href="{{ realtime_refresh_href }}" target="{{ realtime_target }}" mode="{{ realtime_mode }}"><app:realtime-page xmlns:app="https://hypertodo.app/components" request-id="{{ realtime_request_id }}" page="1" />{% endif %}
      <view style="card">
        <text style="title">{% translate "Your session expired" %}</text>
        <text style="copy">{% translate "Sign in again to keep your tasks private." %}</text>
        <view style="button" href="/hv/login/" action="reload"><text style="button-text">{% translate "Return to sign in" %}</text></view>
      </view>
    {% if realtime_enabled %}</app:realtime>{% endif %}
    </body>
  </screen>
</doc>
