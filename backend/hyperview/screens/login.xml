{% load dj_hyperview %}<?xml version="1.0" encoding="UTF-8"?>
<doc xmlns="https://hyperview.org/hyperview">
  <styles>
    <style id="login-body" backgroundColor="{{ theme.brand }}" flex="1" />
    <style id="login-scroll" flexGrow="1" justifyContent="flex-end" />
    <style id="login-hero" alignItems="center" flexGrow="1" justifyContent="center" minHeight="140" paddingHorizontal="24" paddingVertical="24" />
    <style id="hero-mark" alignItems="center" backgroundColor="{{ theme.on_brand_disc }}" borderRadius="24" height="72" justifyContent="center" width="72" />
    <style id="hero-mark-check" color="{{ theme.brand_on_disc }}" fontSize="38" fontWeight="700" />
    <style id="login-brand" color="{{ theme.on_brand }}" fontSize="30" fontWeight="700" marginTop="16" />
    <style id="login-sheet" backgroundColor="{{ theme.canvas }}" borderTopLeftRadius="28" borderTopRightRadius="28" paddingHorizontal="24" paddingTop="28" paddingBottom="16" />
    <style id="card" />
    <style id="card-title" color="{{ theme.ink }}" fontSize="24" fontWeight="700" marginBottom="6" />
    <style id="card-copy" color="{{ theme.ink_muted }}" fontSize="14" lineHeight="20" marginBottom="22" />
    <style id="label" color="{{ theme.ink_label_strong }}" fontSize="13" fontWeight="600" marginBottom="8" />
    <style id="field" backgroundColor="{{ theme.surface }}" borderColor="{{ theme.border_strong }}" borderRadius="16" borderWidth="1" color="{{ theme.ink }}" fontSize="16" marginBottom="16" padding="16" />
    <style id="button" backgroundColor="{{ theme.brand }}" borderRadius="18" padding="17" marginTop="6">
      <modifier pressed="true"><style backgroundColor="{{ theme.brand_pressed }}" /></modifier>
    </style>
    <style id="button-text" color="{{ theme.on_brand }}" fontSize="19" fontWeight="700" textAlign="center">
      <modifier pressed="true"><style color="{{ theme.on_brand }}" /></modifier>
    </style>
    <style id="error-card" backgroundColor="{{ theme.danger_surface }}" borderColor="{{ theme.danger_surface_border }}" borderRadius="12" borderWidth="1" marginBottom="18" padding="12" />
    <style id="error-text" color="{{ theme.danger }}" fontSize="14" fontWeight="600" lineHeight="20" />
    <style id="hint" color="{{ theme.ink_muted }}" fontSize="13" lineHeight="19" marginTop="18" textAlign="center" />
    <style id="optin-row" alignItems="center" flexDirection="row" justifyContent="space-between" marginBottom="16" minHeight="44" />
    <style id="optin-label" color="{{ theme.ink_label_strong }}" flexShrink="1" fontSize="15" fontWeight="600" paddingRight="12" />
    <style id="optin-switch" backgroundColor="{{ theme.switch_off }}" color="{{ theme.on_brand }}">
      <modifier selected="true"><style backgroundColor="{{ theme.brand }}" color="{{ theme.on_brand }}" /></modifier>
    </style>
    <!-- A circle, not a slab: borderRadius must stay height/2, and hyperview
         parses both with parseInt (stylesheets/index.ts:21-23), so keep them
         whole numbers. alignSelf is what stops the fixed width stretching to
         the form's full width. -->
    <style id="biometric-button" alignItems="center" alignSelf="center" backgroundColor="{{ theme.surface }}" borderColor="{{ theme.brand_ink }}" borderRadius="30" borderWidth="2" height="60" justifyContent="center" marginTop="16" width="60">
      <modifier pressed="true"><style backgroundColor="{{ theme.tint_press_fill }}" /></modifier>
    </style>
    <!-- The pressed tint is not decoration. Without a pressed rule of its own a
         child falls back to opacity 0.7 (services/index.ts:33-41), which would
         composite the glyph to #62ABFF over the pressed fill: 2.1:1. Darkening it
         instead of lightening the fill is what clears 3:1 (4.9:1) while the fill
         still visibly changes; the lightest fill that passes on its own, #F2F7FF,
         is 3.1:1 and barely reads as a press. -->
    <style id="biometric-icon" height="24" tintColor="{{ theme.brand_ink }}" width="24">
      <modifier pressed="true"><style tintColor="{{ theme.brand_ink_pressed }}" /></modifier>
    </style>
  </styles>
  <screen id="login-screen">
    <body style="login-body" scroll="true" over-scroll="false" shows-scroll-indicator="false" content-container-style="login-scroll">
      <view style="login-hero">
        <view style="hero-mark"><text style="hero-mark-check">✓</text></view>
        <text style="login-brand">HyperTodo</text>
      </view>
      <view style="login-sheet">
        {% include "fragments/login_panel.xml" %}
      </view>
    </body>
  </screen>
</doc>
