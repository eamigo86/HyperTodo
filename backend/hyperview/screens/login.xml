{% load dj_hyperview %}<?xml version="1.0" encoding="UTF-8"?>
<doc xmlns="https://hyperview.org/hyperview">
  <styles>
    <style id="screen" backgroundColor="#F7F8FC" padding="24" />
    <style id="hero" marginTop="44" marginBottom="28" />
    <style id="mark" alignItems="center" backgroundColor="#278CFF" borderRadius="18" height="56" justifyContent="center" marginBottom="22" width="56" />
    <style id="mark-text" color="#FFFFFF" fontSize="28" fontWeight="700" />
    <style id="eyebrow" color="#278CFF" fontSize="12" fontWeight="700" letterSpacing="1.6" marginBottom="8" />
    <style id="brand" color="#161A35" fontSize="34" fontWeight="700" />
    <style id="subtitle" color="#6D728A" fontSize="16" lineHeight="23" marginTop="8" />
    <style id="card" backgroundColor="#FFFFFF" borderColor="#E9ECF5" borderRadius="28" borderWidth="1" padding="24" />
    <style id="card-title" color="#161A35" fontSize="22" fontWeight="700" marginBottom="6" />
    <style id="card-copy" color="#7A7F95" fontSize="14" lineHeight="20" marginBottom="22" />
    <style id="label" color="#343951" fontSize="13" fontWeight="600" marginBottom="8" />
    <style id="field" backgroundColor="#F1F4FC" borderColor="#E2E7F3" borderRadius="16" borderWidth="1" color="#161A35" fontSize="16" marginBottom="16" padding="16" />
    <style id="button" backgroundColor="#278CFF" borderRadius="18" padding="17" marginTop="6" />
    <style id="button-text" color="#FFFFFF" fontSize="17" fontWeight="700" textAlign="center" />
    <style id="error" backgroundColor="#FFF0EE" borderRadius="12" color="#B42318" fontSize="14" lineHeight="20" marginBottom="18" padding="12" />
    <style id="hint" color="#8A8FA3" fontSize="13" lineHeight="19" marginTop="18" textAlign="center" />
  </styles>
  <screen id="login-screen">
    <body style="screen" scroll="true" shows-scroll-indicator="false">
      <view style="hero">
        <view style="mark"><text style="mark-text">✓</text></view>
        <text style="eyebrow">PLAN WITH INTENTION</text>
        <text style="brand">Welcome to HyperTodo</text>
        <text style="subtitle">A calmer place for everything you need to do.</text>
      </view>
      <form id="login-form">
        <view style="card">
          <text style="card-title">Welcome back</text>
          <text style="card-copy">Sign in to see your tasks and categories.</text>
          {% if form.errors %}<text id="form-errors" style="error">The username or password is incorrect.</text>{% endif %}
          <text style="label">Username</text>
          <text-field id="username" name="username" value="{{ form.username.value|default:'' }}" placeholder="Enter your username" text-content-type="username" style="field" />
          <text style="label">Password</text>
          <text-field id="password" name="password" placeholder="Enter your password" secure-text="true" text-content-type="password" href="/hv/login/" verb="post" action="reload" trigger="submit" style="field" />
          {% hv_csrf_token %}
          <view id="login-submit" style="button" href="/hv/login/" verb="post" action="reload">
            <text style="button-text">Sign in</text>
          </view>
          <text style="hint">Your tasks stay private to your account.</text>
        </view>
      </form>
    </body>
  </screen>
</doc>
