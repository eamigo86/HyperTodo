{% load dj_hyperview %}<?xml version="1.0" encoding="UTF-8"?>
<doc xmlns="https://hyperview.org/hyperview">
  <styles>
    <style id="screen" backgroundColor="#F7F8FC" padding="24" />
    <style id="title" color="#161A35" fontSize="27" fontWeight="700" marginBottom="20" />
    <style id="card" backgroundColor="#FFFFFF" borderRadius="28" padding="20" />
    <style id="label" color="#4C526B" fontSize="13" fontWeight="600" marginTop="12" marginBottom="6" />
    <style id="field" backgroundColor="#F1F4FC" borderRadius="16" padding="13" />
    <style id="button" backgroundColor="#278CFF" borderRadius="18" padding="16" marginTop="22" />
    <style id="button-text" color="#FFFFFF" fontWeight="700" textAlign="center" />
    <style id="error" color="#B42318" marginBottom="10" />
  </styles>
  <screen id="task-form-screen">
    <body style="screen">
      <text style="title">{% if task %}Edit task{% else %}New task{% endif %}</text>
      <form id="task-form">
        <view style="card">
          {% if form.errors %}<text id="form-errors" style="error">Please correct the highlighted task details.</text>{% endif %}
          <text style="label">Title</text><text-field name="title" value="{{ form.title.value|default:'' }}" placeholder="What needs doing?" style="field" />
          <text style="label">Notes</text><text-field name="notes" value="{{ form.notes.value|default:'' }}" placeholder="Optional details" multiline="true" style="field" />
          <text style="label">Category</text>
          <select-single name="category" style="field"><option value="">No category</option>{% for option in form.fields.category.queryset %}<option value="{{ option.id }}"{% if form.category.value|stringformat:'s' == option.id|stringformat:'s' %} selected="true"{% endif %}>{{ option.name }}</option>{% endfor %}</select-single>
          <text style="label">Due date</text><date-field name="due_date" value="{{ form.due_date.value|date:'Y-m-d'|default:'' }}" style="field" />
          <text style="label">Due time</text><text-field name="due_time" value="{{ form.due_time.value|time:'H:i'|default:'' }}" placeholder="HH:MM" style="field" />
          {% hv_csrf_token %}
          <view style="button" href="{% if task %}/hv/tasks/{{ task.id }}/edit/{% else %}/hv/tasks/new/{% endif %}" verb="post" action="replace"><text style="button-text">Save task</text></view>
        </view>
      </form>
    </body>
  </screen>
</doc>
