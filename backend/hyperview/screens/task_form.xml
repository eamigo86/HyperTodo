{% load dj_hyperview %}<?xml version="1.0" encoding="UTF-8"?>
<doc xmlns="https://hyperview.org/hyperview">
  <styles>
    <style id="screen" backgroundColor="#F7F8FC" flex="1" padding="24" />
    <style id="header" alignItems="center" flexDirection="row" marginBottom="20" />
    <style id="back-button" alignItems="center" backgroundColor="#FFFFFF" borderColor="#E1E6F0" borderRadius="20" borderWidth="1" height="40" justifyContent="center" marginRight="12" width="40" />
    <style id="back" color="#4C526B" fontSize="22" fontWeight="500" lineHeight="24" />
    <style id="title" color="#161A35" fontSize="27" fontWeight="700" />
    <style id="card" backgroundColor="#FFFFFF" borderRadius="28" padding="20" />
    <style id="label" color="#4C526B" fontSize="13" fontWeight="600" marginTop="12" marginBottom="6" />
    <style id="field" backgroundColor="#F1F4FC" borderRadius="16" padding="13" />
    <style id="field-invalid" backgroundColor="#FFF7F6" borderColor="#D92D20" borderWidth="1" />
    <style id="field-text" color="#161A35" fontSize="16" />
    <style id="select" backgroundColor="#F1F4FC" borderRadius="16" padding="8" />
    <style id="option" borderRadius="12" marginBottom="4" padding="12">
      <modifier selected="true"><style backgroundColor="#DDE7FF" /></modifier>
    </style>
    <style id="option-text" color="#4C526B" fontSize="15">
      <modifier selected="true"><style color="#1F6FD1" fontWeight="700" /></modifier>
    </style>
    <style id="button" backgroundColor="#278CFF" borderRadius="18" padding="16" marginTop="22" />
    <style id="button-text" color="#FFFFFF" fontWeight="700" textAlign="center" />
    <style id="error-summary" backgroundColor="#FFF0EE" borderRadius="14" color="#B42318" fontWeight="600" marginBottom="10" padding="12" />
    <style id="field-error" color="#B42318" fontSize="12" marginTop="6" />
    <style id="date-modal" backgroundColor="#FFFFFF" borderTopLeftRadius="28" borderTopRightRadius="28" paddingBottom="20" paddingHorizontal="16" shadowColor="#161A35" shadowOffsetY="-4" shadowOpacity="0.12" shadowRadius="12" />
    <style id="date-modal-overlay" backgroundColor="#161A35" opacity="0.35" />
    <style id="date-modal-action" color="#278CFF" fontSize="16" fontWeight="700" padding="18" />
  </styles>
  <screen id="task-form-screen">
    <body style="screen" scroll="true" shows-scroll-indicator="false">
      {% include "fragments/task_form_panel.xml" %}
    </body>
  </screen>
</doc>
