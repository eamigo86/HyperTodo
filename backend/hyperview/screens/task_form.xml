{% load dj_hyperview %}<?xml version="1.0" encoding="UTF-8"?>
<doc xmlns="https://hyperview.org/hyperview">
  <screen id="task-form-screen">
  <styles>
    <style id="screen" backgroundColor="{{ theme.canvas }}" flex="1" />
    <style id="screen-content-style" flex="1" />
    <style id="screen-content-inner" paddingBottom="40" paddingHorizontal="24" paddingTop="20" />
    <style id="screen-header-style" alignItems="center" backgroundColor="{{ theme.brand }}" flexDirection="row" height="44" paddingHorizontal="8" />
    <style id="back-button" alignItems="center" flexDirection="row" height="44" width="84" />
    <style id="back-chevron" color="{{ theme.on_brand }}" fontSize="34" lineHeight="36" marginRight="2" />
    <style id="back-label" color="{{ theme.on_brand }}" fontSize="19" fontWeight="700" />
    <style id="screen-header-title-slot" alignItems="center" flex="1" justifyContent="center" />
    <style id="screen-header-spacer" width="84" />
    <style id="screen-header-title" color="{{ theme.on_brand }}" fontSize="19" fontWeight="700" />
    <style id="card" backgroundColor="{{ theme.surface }}" borderRadius="24" marginBottom="16" padding="20" />
    <style id="section" color="{{ theme.ink }}" fontSize="18" fontWeight="700" marginBottom="12" />
    <style id="label" color="{{ theme.ink_label }}" fontSize="13" fontWeight="600" marginTop="12" marginBottom="6" />
    <style id="field" backgroundColor="{{ theme.field }}" borderColor="{{ theme.field_border }}" borderRadius="16" borderWidth="1" color="{{ theme.ink }}" fontSize="16" minHeight="48" padding="13">
      <modifier pressed="true"><style backgroundColor="{{ theme.field_pressed }}" /></modifier>
      <modifier focused="true"><style borderColor="{{ theme.brand_ink }}" /></modifier>
    </style>
    <style id="field-multiline" minHeight="96" paddingTop="12" textAlignVertical="top" />
    <style id="field-invalid" backgroundColor="{{ theme.danger_field }}" borderColor="{{ theme.danger_border }}" borderWidth="1" />
    <style id="field-text" color="{{ theme.ink }}" fontSize="16" />
    <style id="picker-box" backgroundColor="{{ theme.field }}" borderColor="{{ theme.field_border }}" borderRadius="16" borderWidth="1" justifyContent="center" minHeight="52" paddingHorizontal="12" paddingVertical="2">
      <modifier pressed="true"><style backgroundColor="{{ theme.field_pressed }}" /></modifier>
      <modifier focused="true"><style borderColor="{{ theme.brand_ink }}" /></modifier>
    </style>
    <style id="button" alignItems="center" backgroundColor="{{ theme.brand }}" borderRadius="18" justifyContent="center" marginTop="8" minHeight="56">
      <modifier pressed="true"><style backgroundColor="{{ theme.brand_pressed }}" /></modifier>
    </style>
    <style id="button-text" color="{{ theme.on_brand }}" fontSize="19" fontWeight="700" textAlign="center">
      <modifier pressed="true"><style color="{{ theme.on_brand }}" /></modifier>
    </style>
    <style id="error-card" backgroundColor="{{ theme.danger_surface }}" borderColor="{{ theme.danger_surface_border }}" borderRadius="12" borderWidth="1" marginBottom="16" padding="12" />
    <style id="error-text" color="{{ theme.danger }}" fontSize="14" fontWeight="600" lineHeight="20" />
    <style id="field-error" color="{{ theme.danger }}" fontSize="13" marginTop="6" />
    <style id="date-modal" backgroundColor="{{ theme.surface }}" borderTopLeftRadius="28" borderTopRightRadius="28" paddingBottom="20" paddingHorizontal="16" shadowColor="{{ theme.scrim }}" shadowOffsetY="-4" shadowOpacity="0.12" shadowRadius="12" />
    <style id="date-modal-overlay" backgroundColor="{{ theme.scrim }}" opacity="0.35" />
    <style id="date-modal-action" color="{{ theme.brand_ink }}" fontSize="16" fontWeight="700" padding="18" />
  </styles>
    <body style="screen">
      {% if realtime_enabled %}<app:realtime xmlns:app="https://hypertodo.app/components" resources="{{ realtime_resources }}" refresh-href="{{ realtime_refresh_href }}" target="{{ realtime_target }}" mode="{{ realtime_mode }}"{% if realtime_entities %} entities="{{ realtime_entities }}"{% endif %}><app:realtime-page xmlns:app="https://hypertodo.app/components" request-id="{{ realtime_request_id }}" page="1" />{% endif %}
      {% include "partials/screen_header.xml" with header_title=header_title back_id="task-back" %}
      <view id="screen-content" style="screen-content-style" scroll="true" shows-scroll-indicator="false" content-container-style="screen-content-inner" keyboard-dismiss-mode="on-drag">
        {% include "fragments/task_form_panel.xml" %}
      </view>
    {% if realtime_enabled %}</app:realtime>{% endif %}
    </body>
  </screen>
</doc>
