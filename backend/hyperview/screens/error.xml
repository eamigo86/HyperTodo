{% load i18n %}<?xml version="1.0" encoding="UTF-8"?>
<doc xmlns="https://hyperview.org/hyperview">
  <screen id="error-screen">
  <styles>
    <style id="screen" backgroundColor="{{ theme.brand }}" justifyContent="center" padding="28" />
    <style id="error-card" backgroundColor="{{ theme.surface }}" borderRadius="28" padding="24" />
    <style id="error-title" color="{{ theme.ink }}" fontSize="24" fontWeight="700" />
    <style id="error-copy" color="{{ theme.ink_muted }}" fontSize="16" lineHeight="22" marginTop="8" />
    <style id="error-button" backgroundColor="{{ theme.brand }}" borderRadius="18" marginTop="24" padding="16">
      <modifier pressed="true"><style backgroundColor="{{ theme.brand_pressed }}" /></modifier>
    </style>
    <style id="error-button-text" color="{{ theme.on_brand }}" fontSize="19" fontWeight="700" textAlign="center">
      <modifier pressed="true"><style color="{{ theme.on_brand }}" /></modifier>
    </style>
  </styles>
    <body style="screen">
      <view style="error-card">
        <text style="error-title">{% translate "Something went wrong" %}</text>
        <text style="error-copy">{{ message }}</text>
        <view style="error-button" href="{{ home_href }}" action="reload"><text style="error-button-text">{% translate "Return home" %}</text></view>
      </view>
    </body>
  </screen>
</doc>
