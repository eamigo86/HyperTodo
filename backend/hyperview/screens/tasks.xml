{% load dj_hyperview %}<?xml version="1.0" encoding="UTF-8"?>
<doc xmlns="https://hyperview.org/hyperview">
  <styles>
    <style id="screen" backgroundColor="#F7F8FC" flex="1" />
    <style id="screen-content" flex="1" padding="24" />
    <style id="screen-header" alignItems="center" backgroundColor="#278CFF" flexDirection="row" height="58" justifyContent="center" paddingHorizontal="4" />
    <style id="back-button" alignItems="center" height="44" justifyContent="center" width="52" />
    <style id="screen-header-title-slot" alignItems="center" flex="1" justifyContent="center" />
    <style id="screen-header-spacer" width="52" />
    <style id="back" color="#FFFFFF" fontSize="28" fontWeight="400" lineHeight="30" />
    <style id="screen-header-title" color="#FFFFFF" fontSize="19" fontWeight="700" />
    <style id="filter-summary" color="#6D728A" fontSize="13" marginBottom="10" />
    <style id="filters" flexDirection="row" flexWrap="wrap" marginBottom="10" />
    <style id="chip" backgroundColor="#EEF2FC" borderRadius="16" marginBottom="8" marginRight="8" paddingHorizontal="12" paddingVertical="9" />
    <style id="chip-active" backgroundColor="#DDE7FF" />
    <style id="chip-text" color="#4C526B" fontSize="13" />
    <style id="task-list" flex="1" />
    <style id="empty-item" paddingVertical="24" />
    <style id="list-spinner" alignItems="center" height="28" justifyContent="center" />
    <style id="swipe-row" borderRadius="22" marginBottom="12" overflow="hidden" />
    <style id="task" backgroundColor="#FFFFFF" borderRadius="22" padding="16" />
    <style id="done" opacity="0.55" />
    <style id="task-title" color="#20243D" fontSize="17" fontWeight="600" />
    <style id="meta" color="#7B8097" fontSize="13" marginTop="5" />
    <style id="bottom-navigation" alignItems="center" backgroundColor="#FFFFFF" borderTopColor="#E7EAF3" borderTopWidth="1" flexDirection="row" height="72" justifyContent="space-around" paddingHorizontal="8" />
    <style id="nav-hit-area" alignItems="center" flex="1" justifyContent="center" />
    <style id="nav-item" alignItems="center" height="52" justifyContent="center" width="64" />
    <style id="nav-active" opacity="1" />
    <style id="nav-icon" height="24" width="24" />
    <style id="nav-label" color="#68708B" fontSize="10" fontWeight="600" marginTop="3" />
    <style id="nav-label-active" color="#278CFF" fontWeight="700" />
    <style id="nav-add" alignItems="center" backgroundColor="#278CFF" borderRadius="24" height="48" justifyContent="center" width="48" />
    <style id="nav-add-symbol" color="#FFFFFF" fontSize="29" fontWeight="400" lineHeight="31" />
    <style id="side-menu" bottom="0" flexDirection="row" left="0" position="absolute" right="0" top="0" zIndex="50" />
    <style id="side-menu-panel" backgroundColor="#FFFFFF" flex="1" padding="24" width="286" />
    <style id="side-menu-header" alignItems="center" flexDirection="row" justifyContent="space-between" marginBottom="16" />
    <style id="side-menu-eyebrow" color="#278CFF" fontSize="11" fontWeight="700" letterSpacing="1.5" />
    <style id="side-menu-title" color="#161A35" fontSize="22" fontWeight="700" marginTop="3" />
    <style id="side-menu-user" color="#7B8097" fontSize="13" marginBottom="28" />
    <style id="side-menu-links" flex="1" />
    <style id="side-menu-link" borderRadius="16" marginBottom="8" padding="15" />
    <style id="side-menu-link-active" backgroundColor="#EEF3FF" />
    <style id="side-menu-link-text" color="#20243D" fontSize="16" fontWeight="600" />
    <style id="side-menu-logout-panel" borderTopColor="#E7EAF3" borderTopWidth="1" paddingTop="16" />
    <style id="side-menu-logout" borderRadius="16" padding="15" />
    <style id="side-menu-logout-text" color="#B42318" fontSize="16" fontWeight="600" />
  </styles>
  <screen id="tasks-screen">
    <body style="screen">
      {% include "partials/screen_header.xml" with header_title="Tasks" back_id="task-list-back" %}
      <view id="screen-content" style="screen-content">
        <text id="filter-summary" style="filter-summary">{{ status_filter|title }} tasks{% if selected_category %} · {{ selected_category.name }}{% endif %}</text>
        <view style="filters">
          <view id="filter-all" style="chip{% if status_filter == 'all' %} chip-active{% endif %}" href="/hv/tasks/?status=all" action="reload"><text style="chip-text">All</text></view>
          <view id="filter-active" style="chip{% if status_filter == 'active' %} chip-active{% endif %}" href="/hv/tasks/?status=active" action="reload"><text style="chip-text">Active</text></view>
          <view id="filter-completed" style="chip{% if status_filter == 'completed' %} chip-active{% endif %}" href="/hv/tasks/?status=completed" action="reload"><text style="chip-text">Done</text></view>
          <view id="filter-today" style="chip{% if status_filter == 'today' %} chip-active{% endif %}" href="/hv/tasks/?status=today" action="reload"><text style="chip-text">Today</text></view>
          <view id="filter-scheduled" style="chip{% if status_filter == 'scheduled' %} chip-active{% endif %}" href="/hv/tasks/?status=scheduled" action="reload"><text style="chip-text">Scheduled</text></view>
          <view id="filter-overdue" style="chip{% if status_filter == 'overdue' %} chip-active{% endif %}" href="/hv/tasks/?status=overdue" action="reload"><text style="chip-text">Overdue</text></view>
        </view>
        {% if categories %}
        <view style="filters">
          {% for category in categories %}<view style="chip{% if selected_category.id == category.id %} chip-active{% endif %}" href="/hv/tasks/?status={{ status_filter }}&amp;category={{ category.id }}" action="reload"><text style="chip-text">{{ category.name }}</text></view>{% endfor %}
        </view>
        {% endif %}
        {% include "fragments/task_list.xml" %}
        <view id="task-list-spinner" style="list-spinner" hide="true"><spinner /></view>
      </view>
      {% include "fragments/bottom_navigation.xml" with active_nav="tasks" %}
      {% include "fragments/side_menu_host.xml" %}
    </body>
  </screen>
</doc>
